# ============================================
# frontend/Dockerfile.dev - Desarrollo
# ============================================

FROM node:20-alpine

WORKDIR /app

# 1. Copiar package.json
COPY package*.json ./

# 2. Instalar dependencias incluyendo tailwindcss
RUN npm install && npm install -D tailwindcss@3.4.0 postcss autoprefixer

# 3. Copiar el resto del código
COPY . .

# 4. Exponer puerto
EXPOSE 5173

# 5. Comando de inicio
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]